      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "7 */1 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "telematics-3",
      "name": "Выбрать активные сессии",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        200
      ],
      "parameters": {
        "url": "http://127.0.0.1:3008/api/mock/schedule/telematics",
        "options": {
          "timeout": 20000
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "onError": "continueErrorOutput",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 1000,
      "credentials": {
        "httpHeaderAuth": {
          "id": "fleet-schedule-telematics",
          "name": "Парк · расписание telematics"
        }
      }
    },
    {
      "id": "telematics-4",
      "name": "Контекст запуска",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "jsCode": "const data=$input.first().json; const runs=data.runs||[data.body||data]; return runs.map(c=>{if(!c.run||!c.space||!c.signature)throw new Error('Нет подписанного контекста');return {json:c}});"
      }
    },
    {
      "id": "telematics-5",
      "name": "Загрузить источник",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "url": "http://127.0.0.1:3008/api/mock/telematics/snapshot",
        "options": {
          "timeout": 20000
        },
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{$json}}"
      },
      "onError": "continueErrorOutput",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 1000
    },
    {
      "id": "telematics-6",
      "name": "Нормализовать данные",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const raw=$json;if(raw.mode!=='synthetic'||!Array.isArray(raw.value))throw new Error('Неверная схема источника');const rows=raw.value.map(r=>({vehicle_code:r.vehicle,mileage:String(r.odometer)}));for(const r of rows){if(!r.vehicle_code)throw new Error('Нет автомобиля');for(const [k,v] of Object.entries(r)){if(!['vehicle_code','external_id'].includes(k)&&(!Number.isFinite(Number(v))||Number(v)<0))throw new Error('Некорректное значение');}}return {json:{context:raw.context,rows,signature:raw.signature,execution_id:String($execution.id)}};"
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "telematics-7",
      "name": "Подписанный пакет → учёт",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "url": "http://127.0.0.1:3008/api/v1/integrations/ingest",
        "options": {
          "timeout": 20000
        },
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{$json}}"
      },
      "onError": "continueErrorOutput",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 1000
    },
    {
      "id": "telematics-8",
      "name": "Ошибка источника",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        240
      ],
      "parameters": {
        "jsCode": "throw new Error('Источник не прошёл проверку или приём. Учётные операции не изменены.');"
      }
    },
    {
      "id": "telematics-9",
      "name": "Готово",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        0
      ],
      "parameters": {
        "jsCode": "return $input.all();"
      }
    }
