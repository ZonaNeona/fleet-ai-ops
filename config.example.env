DATABASE_URL=postgresql+psycopg://fleet:REPLACE_ME@127.0.0.1/fleet
PUBLIC_URL=https://fleet.example.com
FILE_ROOT=/var/lib/fleet/files
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
TEXT_MODELS=qwen/qwen3.8-flash,deepseek/deepseek-v4.1-flash
VISION_MODEL=google/gemini-2.5-flash-lite
DAILY_BUDGET=0.50
TELEGRAM_BOT_TOKEN=
TELEGRAM_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# 1С: live base over standard OData (empty = emulator); writes only with ONEC_WRITE=1
ONEC_ODATA_URL=
ONEC_USER=
ONEC_PASSWORD=
ONEC_WRITE=
# Redis (limits, report cache, live events); empty = in-process fallback
REDIS_URL=redis://127.0.0.1:6379/0
WRITE_LIMIT=240
SESSION_LIMIT=6
# Errors to Sentry (optional)
SENTRY_DSN=
# Payments: YooKassa test shop (empty = emulator), Telegram test provider token from BotFather
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
TELEGRAM_PAYMENT_TOKEN=
# Mail: IMAP mailbox for incoming documents (plus-addressing routes letters to demo spaces)
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=
# Google Sheets: path to a service-account key file and a table shared with that account
GOOGLE_SA_JSON=
GOOGLE_SHEET_ID=
# VK community bot (Callback API) and MAX bot
VK_TOKEN=
VK_SECRET=
VK_CONFIRMATION=
MAX_TOKEN=
MAX_SECRET=
# Robot: where the training portal is (the API itself); Playwright browsers shared by the worker's user
ROBOT_BASE=http://127.0.0.1:3008
PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright
# Local model for documents with personal data (Ollama, OpenAI-compatible)
OLLAMA_URL=
OLLAMA_VISION_MODEL=qwen2.5vl:3b
PII_LOCAL=0
# Commented lines show the defaults.
# DeepSeek directly, before OpenRouter (optional); prices in USD per token for the daily budget.
# AI_ENV points to an extra env file with these keys, readable by the service user only.
# AI_ENV=/etc/demo-ai/deepseek.env
DEEPSEEK_API_KEY=
# DEEPSEEK_MODELS=deepseek-flash
# DEEPSEEK_PRICE_PROMPT=0.0000003
# DEEPSEEK_PRICE_COMPLETION=0.0000006
# STT_MODEL=google/gemini-2.5-flash-lite
# Bitrix24: a live portal's inbound webhook (empty = emulator); writes to it only with BITRIX24_WRITE=1
BITRIX24_WEBHOOK=
BITRIX24_WRITE=
# B24APP_URL=<PUBLIC_URL>/b24app
# B24_EMULATOR_URL=<PUBLIC_URL>
# Virtual PBX (Mango Office format); empty = keys derived per demo space
MANGO_API_KEY=
MANGO_API_SALT=
# PBX_WEBHOOK_URL=<B24_EMULATOR_URL>
# Hermes Agent profile (scripts/setup_hermes.sh fills these); empty = the built-in agent loop
HERMES_API_URL=
HERMES_API_KEY=
FLEET_HERMES_MCP_KEY=
# stdio MCP server (python -m app.mcp): the demo space it works in
FLEET_MCP_SPACE=
# Misc: extra allowed origins (comma-separated), search engines may index /auto, Sentry details, IMAP port
EXTRA_ORIGINS=
SITE_INDEX=0
# SENTRY_ENV=demo
# SENTRY_TRACES=0.05
# IMAP_PORT=993
