DATABASE_URL=postgresql+psycopg://fleet:REPLACE_ME@127.0.0.1/fleet
PUBLIC_URL=https://fleet.example.com
FILE_ROOT=/var/lib/fleet/files
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
TEXT_MODELS=qwen/qwen3.8-flash,deepseek/deepseek-v4.1-flash
VISION_MODEL=google/gemini-2.5-flash-lite
DAILY_BUDGET=0.50
TELEGRAM_BOT_TOKEN=
TELEGRAM_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# 1С: live base over standard OData (empty = emulator); writes only with ONEC_WRITE=1
ONEC_ODATA_URL=
ONEC_USER=
ONEC_PASSWORD=
ONEC_WRITE=
# Redis (limits, report cache, live events); empty = in-process fallback
REDIS_URL=redis://127.0.0.1:6379/0
WRITE_LIMIT=240
SESSION_LIMIT=6
# Errors to Sentry (optional)
SENTRY_DSN=
# Payments: YooKassa test shop (empty = emulator), Telegram test provider token from BotFather
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
TELEGRAM_PAYMENT_TOKEN=
